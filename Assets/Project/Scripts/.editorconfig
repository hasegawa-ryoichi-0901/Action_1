root = true

[*.{cs,vb}]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]

csharp_new_line_before_open_brace = none
csharp_new_line_before_open_brace_types = false
csharp_new_line_before_open_brace_methods = false
csharp_new_line_before_open_brace_accessors = false
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_block_contents = true
csharp_indent_switch_labels = true
csharp_preprocessor_directives_indented = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_separate_import_directive_groups = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_braces = true:warning
dotnet_style_prefer_switch_expression = true:warning
dotnet_style_prefer_pattern_matching = true:warning
csharp_style_prefer_utf8_string_literals = true:warning
csharp_style_expression_bodied_methods = when_possible:silent
csharp_style_expression_bodied_properties = when_possible:warning
dotnet_style_prefer_null_check_over_type_check = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_readonly_struct = true:warning
dotnet_diagnostic.IDE0058.severity = silent

dotnet_naming_rule.private_protected_fields_have_underscore_prefix.symbols = private_protected_fields
dotnet_naming_rule.private_protected_fields_have_underscore_prefix.style = underscore_prefix_camel_case
dotnet_naming_rule.private_protected_fields_have_underscore_prefix.severity = warning

dotnet_naming_rule.public_constants_use_all_caps.symbols = public_constants
dotnet_naming_rule.public_constants_use_all_caps.style = all_caps_with_underscores
dotnet_naming_rule.public_constants_use_all_caps.severity = warning

dotnet_naming_rule.public_members_use_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_use_pascal_case.style = pascal_case
dotnet_naming_rule.public_members_use_pascal_case.severity = warning

dotnet_naming_rule.parameters_use_camel_case.symbols = parameters
dotnet_naming_rule.parameters_use_camel_case.style = camel_case
dotnet_naming_rule.parameters_use_camel_case.severity = warning

dotnet_naming_rule.all_methods_use_pascal_case.symbols = all_methods
dotnet_naming_rule.all_methods_use_pascal_case.style = pascal_case
dotnet_naming_rule.all_methods_use_pascal_case.severity = warning

dotnet_naming_rule.all_classes_use_pascal_case.symbols = all_classes
dotnet_naming_rule.all_classes_use_pascal_case.style = pascal_case
dotnet_naming_rule.all_classes_use_pascal_case.severity = warning

dotnet_naming_rule.async_methods_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_with_async.style = async_suffix_pascal_case
dotnet_naming_rule.async_methods_end_with_async.severity = warning

dotnet_naming_symbols.private_protected_fields.applicable_kinds = field
dotnet_naming_symbols.private_protected_fields.applicable_accessibilities = private, protected, protected_internal

dotnet_naming_symbols.public_constants.applicable_kinds = field
dotnet_naming_symbols.public_constants.applicable_accessibilities = public
dotnet_naming_symbols.public_constants.required_modifiers = const

dotnet_naming_symbols.parameters.applicable_kinds = parameter

dotnet_naming_symbols.public_members.applicable_kinds = property, method, field, event
dotnet_naming_symbols.public_members.applicable_accessibilities = public

dotnet_naming_symbols.all_methods.applicable_kinds = method
dotnet_naming_symbols.all_methods.applicable_accessibilities = public, internal, protected, protected_internal, private, private_protected

dotnet_naming_symbols.all_classes.applicable_kinds = class
dotnet_naming_symbols.all_classes.applicable_accessibilities = public, internal, protected, protected_internal, private, private_protected

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async

dotnet_naming_style.underscore_prefix_camel_case.required_prefix = _
dotnet_naming_style.underscore_prefix_camel_case.capitalization = camel_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.all_caps_with_underscores.capitalization = all_upper
dotnet_naming_style.all_caps_with_underscores.required_prefix =
dotnet_naming_style.all_caps_with_underscores.required_suffix =
dotnet_naming_style.all_caps_with_underscores.word_separator = _

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.async_suffix_pascal_case.capitalization = pascal_case
dotnet_naming_style.async_suffix_pascal_case.required_suffix = Async
